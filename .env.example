# Railway automatically provides PORT, but you can override it
PORT=3000

# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_from_botfather
ADMIN_TELEGRAM_ID=123456789

# Database (Railway PostgreSQL or Neon)
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Commission settings
SERVICE_FEE_PERCENT=3

# Optional: Webhook (Railway usually works fine with polling)
# If you set this, Railway will use webhook instead of polling
# WEBHOOK_URL=https://your-app.up.railway.app

# TON (payments: native TON + USDT jetton on TON)
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=your_toncenter_api_key
# 24-word mnemonic of the bot's single escrow wallet (deposits + instant payouts)
TON_ESCROW_MNEMONIC=word1 word2 word3 ... word24
# Official Tether USDt jetton master on TON mainnet (default is correct, override only for testnet)
# TON_USDT_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# Forum group for isolated per-deal chats (Topics must be enabled, bot must be admin
# with "Manage Topics" permission). Get the chat id by adding @RawDataBot to the group.
FORUM_GROUP_CHAT_ID=-1001234567890
# Optional: only set if the group is public (has a @username)
FORUM_GROUP_USERNAME=
